{
  "manifest_version": 3,
  "name": "EasyCopy",
  "version": "1.0.2",
  "description": "드래그 후 자동 복사와 사이트별 복사 방지 해제를 선택해서 사용합니다.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "clipboardWrite", "offscreen", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "extension/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "EasyCopy 설정",
    "default_popup": "extension/popup.html",
    "default_icon": {
      "16": "extension/icons/16.png",
      "32": "extension/icons/32.png"
    }
  },
  "icons": {
    "16": "extension/icons/16.png",
    "32": "extension/icons/32.png",
    "48": "extension/icons/48.png",
    "128": "extension/icons/128.png"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["extension/shared.js", "extension/content.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true,
    "match_origin_as_fallback": true
  }]
}
